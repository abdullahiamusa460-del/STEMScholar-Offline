# STEMScholar Offline configuration
# Switch the chat model here. Default: gemma4:e2b-it-qat
# If your laptop has little RAM, use: gemma3:1b
STEM_MODEL=gemma4:e2b-it-qat

# Optional: override Ollama host (default http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Embedding model used for "Use my notes" search
STEM_EMBED_MODEL=snowflake-arctic-embed:33m

# Default UI settings (overridable in Settings panel)
# STEM_THEME=dark
# STEM_ACCENT=#22d3ee
# STEM_FONT_SIZE=14
# STEM_TEMPERATURE=0.4
# STEM_MAX_TOKENS=700
# STEM_STREAM=true
